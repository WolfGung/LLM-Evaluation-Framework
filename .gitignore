# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Test reports, and the published page built from them (python -m tools.site)
allure-results/
allure-report/
site/

# Live-mode results: not reproducible from cassettes, never committed
results-live/

# A manifest being written (record renames it into place when complete)
cassettes/.manifest.json.partial
# Held while make record runs: one record run at a time
cassettes/.record.lock
# A cassette file being rewritten by make prune (renamed into place when written)
cassettes/.*.jsonl.partial

# Held while make label runs: one labelling session at a time
labels/.label.lock

# Local secrets
.env
